# Copy to apps/collector/.env (gitignored). Secrets also go to 1Password; never commit them.
# Run: bun run collect            (all configured sources; launchd runs this daily)
#      bun run collect status     (what is configured, last run per source)
#      bun run collect auth google         (one-time consent; writes GOOGLE_REFRESH_TOKEN below)
#      bun run collect auth google-health  (separate consent for Google Health; writes GOOGLE_HEALTH_REFRESH_TOKEN)

KB_ROOT=/Users/you/git/my-knowledge

# --- GitHub: fine-grained PAT, read-only (Metadata + Contents + Issues + Pull requests: Read) on the repos to track
GITHUB_TOKEN=
# optional: skip the /user lookup
GITHUB_LOGIN=

# --- Google (Gmail / Calendar / YouTube / Google Health): one OAuth client, type "Desktop app"
# Consent screen: publish to "In production" (in "Testing" the refresh token expires after 7 days).
# Scopes: gmail.modify, calendar.readonly, youtube.readonly (GOOGLE_REFRESH_TOKEN)
#         googlehealth.activity_and_fitness.readonly, googlehealth.sleep.readonly (GOOGLE_HEALTH_REFRESH_TOKEN:
#         the Health API rejects tokens that also carry non-health scopes, so it has its own consent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_HEALTH_REFRESH_TOKEN=
# optional: comma-separated calendar ids ("primary" ok). Default: calendars shown (selected) in Google Calendar.
GOOGLE_CALENDAR_IDS=
# optional: comma-separated YouTube playlist ids to collect in addition to liked videos
YOUTUBE_PLAYLIST_IDS=
# optional: set to "off" to skip a Google source
GMAIL=
GOOGLE_HEALTH=

# --- LinkedIn: nothing to set. Download "Get a copy of your data" from LinkedIn settings and drop the ZIP
#     (…LinkedInDataExport….zip) into 000_inbox or the WebUI 投げ込み; the next run turns it into a feed.
