# Copy to apps/collector/.env (gitignored, chmod 600: every `bun run collect` enforces it). Secrets also go to 1Password; never commit them.
# Run: bun run collect            (all configured sources; launchd runs this daily)
#      bun run collect status     (what is configured, last run per source)
#      bun run collect auth                (both Google consents, one after the other; writes the tokens below)
#      bun run collect auth google | auth google-health   (just one of them)
#      bun run collect auth google --account work --sources gmail,calendar   (an extra Google account, see the end)

KB_ROOT=/Users/you/git/my-knowledge

# --- GitHub: fine-grained PAT, read-only (Metadata + Contents + Issues + Pull requests: Read) on the repos to track.
#     Pushes / reviews / stars come from /users/:login/events; add the "Events" user permission (Read) to see the
#     private ones, otherwise only public events are listed.
#     GitHub mails you before the PAT expires; when it is refused (401) the daily run sends a macOS notification and
#     the morning digest shows `github 認証失敗`. Rotate: regenerate the PAT on GitHub, then update GITHUB_TOKEN.
GITHUB_TOKEN=
# optional: skip the /user lookup
GITHUB_LOGIN=

# --- RSS / Atom: feed URLs, comma- or whitespace-separated (quote the value to spread it over lines). Each feed with
#     new entries writes collect-rss-<slug>-<from>_<to>.json (title / url / date / head of the summary, no bodies).
#     Unset = the source is skipped.
FEED_URLS=

# --- Google (Gmail / Calendar / YouTube / Google Health): one OAuth client, type "Desktop app"
# Publish the consent screen to "In production": in "Testing" Google expires refresh tokens 7 days after consent.
# No expiry is tracked; when Google refuses a token (invalid_grant) the daily run sends a macOS notification and the
# morning digest shows the source as 認証失敗. Renew with `bun run collect auth`.
# Scopes: gmail.modify, calendar.readonly, youtube.readonly (GOOGLE_REFRESH_TOKEN)
#         googlehealth.activity_and_fitness.readonly, googlehealth.sleep.readonly (GOOGLE_HEALTH_REFRESH_TOKEN:
#         the Health API rejects tokens that also carry non-health scopes, so it has its own consent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_HEALTH_REFRESH_TOKEN=
# optional: comma-separated calendar ids ("primary" ok). Default: calendars shown (selected) in Google Calendar.
GOOGLE_CALENDAR_IDS=
# optional: how far ahead upcoming events are tracked, in days. Default: 2 years.
GOOGLE_CALENDAR_HORIZON_DAYS=
# optional: comma-separated YouTube playlist ids to collect in addition to liked videos
YOUTUBE_PLAYLIST_IDS=
# optional: set to "off" to skip a Google source (GMAIL=off also stops the weekly システム/要確認 digest)
GMAIL=
GMAIL_REVIEW=
GOOGLE_HEALTH=

# --- LinkedIn: nothing to set. Download "Get a copy of your data" from LinkedIn settings and drop the ZIP
#     (…LinkedInDataExport….zip) into 000_inbox or the WebUI 投げ込み; the next run turns it into a feed.

# --- Extra accounts (optional): the same variables with a __<name> suffix (name: [a-z0-9]+). Each extra account runs its
#     own copy of the sources (ids `calendar@work`, files `collect-calendar-…@work.json` / `mail-…@work.json`), with its
#     own cursor, and shows up as `calendar@work` in `status`, the morning digest and the auth-failure notification.
#     The OAuth client above is shared; the default account's per-account settings (GOOGLE_CALENDAR_IDS, GMAIL=off, …)
#     are not inherited. Google Health is single-account (two accounts would double count in the monthly health_log).
#   Google: `bun run collect auth google --account work --sources gmail,calendar` writes both lines below (sign in with
#     that account in the browser). GOOGLE_SOURCES__<name> picks the sources (gmail, calendar, youtube; `gmail` includes
#     the weekly gmail-review digest, GMAIL_REVIEW__<name>=off turns it off; unset = all). The consent only asks for the
#     scopes of those sources. The account's Gmail needs the same Apps Script labels (900_system/gas/emailfilter) as the
#     default one: the collector only reads labels. A Workspace admin may block an unverified Desktop-app client: if the
#     consent screen refuses, there is nothing to configure here.
# GOOGLE_REFRESH_TOKEN__work=
# GOOGLE_SOURCES__work=gmail,calendar
# GOOGLE_CALENDAR_IDS__work=
#   GitHub: a fine-grained PAT created while signed in to the other account (same permissions as GITHUB_TOKEN).
# GITHUB_TOKEN__work=
# GITHUB_LOGIN__work=
