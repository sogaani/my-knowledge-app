# Copy to apps/collector/.env (gitignored). Secrets also go to 1Password; never commit them.
# Run: bun run collect            (all configured sources; launchd runs this daily)
#      bun run collect status     (what is configured, last run per source)
#      bun run collect auth                (both Google consents, one after the other; writes the tokens below)
#      bun run collect auth google | auth google-health   (just one of them)

KB_ROOT=/Users/you/git/my-knowledge

# --- GitHub: fine-grained PAT, read-only (Metadata + Contents + Issues + Pull requests: Read) on the repos to track.
#     Pushes / reviews / stars come from /users/:login/events; add the "Events" user permission (Read) to see the
#     private ones, otherwise only public events are listed.
GITHUB_TOKEN=
# optional: skip the /user lookup
GITHUB_LOGIN=

# --- RSS / Atom: feed URLs, comma- or whitespace-separated (quote the value to spread it over lines). Each feed with
#     new entries writes collect-rss-<slug>-<from>_<to>.json (title / url / date / head of the summary, no bodies).
#     Unset = the source is skipped.
FEED_URLS=

# --- Google (Gmail / Calendar / YouTube / Google Health): one OAuth client, type "Desktop app"
# Consent screen in "Testing": refresh tokens expire 7 days after consent. The daily run sends a macOS notification
# the day before and when one has expired; renew with `bun run collect auth`. Published to "In production": set
# GOOGLE_TOKEN_TTL_DAYS=0.
# Scopes: gmail.modify, calendar.readonly, youtube.readonly (GOOGLE_REFRESH_TOKEN)
#         googlehealth.activity_and_fitness.readonly, googlehealth.sleep.readonly (GOOGLE_HEALTH_REFRESH_TOKEN:
#         the Health API rejects tokens that also carry non-health scopes, so it has its own consent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_HEALTH_REFRESH_TOKEN=
# written by `collect auth` (used for the expiry warning)
GOOGLE_REFRESH_TOKEN_ISSUED_AT=
GOOGLE_HEALTH_REFRESH_TOKEN_ISSUED_AT=
# optional: refresh token lifetime in days (default 7 = consent screen in Testing; 0 = no expiry)
GOOGLE_TOKEN_TTL_DAYS=
# optional: comma-separated calendar ids ("primary" ok). Default: calendars shown (selected) in Google Calendar.
GOOGLE_CALENDAR_IDS=
# optional: how far ahead upcoming events are tracked, in days. Default: 2 years.
GOOGLE_CALENDAR_HORIZON_DAYS=
# optional: comma-separated YouTube playlist ids to collect in addition to liked videos
YOUTUBE_PLAYLIST_IDS=
# optional: set to "off" to skip a Google source (GMAIL=off also stops the weekly システム/要確認 digest)
GMAIL=
GMAIL_REVIEW=
GOOGLE_HEALTH=

# --- LinkedIn: nothing to set. Download "Get a copy of your data" from LinkedIn settings and drop the ZIP
#     (…LinkedInDataExport….zip) into 000_inbox or the WebUI 投げ込み; the next run turns it into a feed.
