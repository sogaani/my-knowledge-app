PORT=8787
KB_ROOT=/data/kb
DATA_DIR=/data/app
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=<application audience tag>
ALLOWED_EMAILS=you@example.com
WORKER_SERVICE_TOKEN_NAME=<service token Client ID (JWT common_name)>
WORKER_TOKEN=<random shared secret, also set on the Mac worker>
GIT_AUTHOR=kb-web <kb-web@local>
SYNC_INTERVAL_SEC=300
# how long GET /api/search waits for the Mac worker before falling back to keyword search
SEARCH_TIMEOUT_MS=8000
# the API pod has no Ollama; never try to embed there
KB_EMBED=off
# local dev only:
# DEV_BYPASS_AUTH=1
